# ── Local development defaults ─────────────────────────────────────────────────
# Copy this file to .env and fill in values. .env is git-ignored.
# Do not commit real credentials, tokens, or personal data.

# Database provider: 'sqlite' (default, local dev) or 'postgres' (cloud/shared pilot).
DATABASE_PROVIDER=sqlite

# SQLite mode: path to the local database file.
DATABASE_URL=file:./data/lean-project-control.db

# PostgreSQL mode: replace the line above with a full connection string, e.g.:
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://lean_app:replace-password@localhost:5432/lean_project_control

# Demo login used by the local single-user walkthrough (SQLite mode only).
DEMO_LOGIN_NAME=rrms.demo.pm

# Local testing only. When true, requests may select another seeded demo account
# with the x-demo-login header. Must be false in any shared/cloud environment.
ALLOW_DEMO_IDENTITY_OVERRIDE=false

# ── Security ────────────────────────────────────────────────────────────────────
# When set, every /api/* request must include: Authorization: Bearer <value>
# Generate a strong random value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank (unset) for local development — the guard is skipped entirely.
API_SECRET_KEY=

# ── Network binding ─────────────────────────────────────────────────────────────
# HOST defaults to 127.0.0.1 (localhost-only, safe for local dev).
# Set HOST=0.0.0.0 in cloud environments (Render, Koyeb, Docker) so the
# reverse proxy can reach the process. Always use TLS in production.
HOST=127.0.0.1
PORT=3000

# ── PostgreSQL connection (for Docker local or cloud) ───────────────────────────
# Only required when DATABASE_PROVIDER=postgres.
POSTGRES_DB=lean_project_control
POSTGRES_USER=lean_app
POSTGRES_PASSWORD=replace-with-a-local-development-secret
POSTGRES_PORT=5432
